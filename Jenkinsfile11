pipeline {
    agent any
    environment {
        REPO_URL = 'https://github.com/Faizamunir720/django-todo-cicd.git'
        BRANCH   = 'develop'
    }

    stages {
        stage('Code Checkout') {
            steps {
                // Get the code from the given repository and branch
                git branch: "${env.BRANCH}", url: "${env.REPO_URL}"

                // Show repository details and workspace contents
                sh '''
                    echo "========== Repository details =========="
                    echo "Repository name : $(basename -s .git "$(git config --get remote.origin.url)")"
                    echo "Remote URL      : $(git config --get remote.origin.url)"
                    echo "Current branch  : $(git rev-parse --abbrev-ref HEAD)"
                    echo "Latest commit   : $(git log -1 --oneline)"
                    echo "========== Files in workspace: $WORKSPACE =========="
                    ls -la
                '''
            }
        }
        stage('Build') {
            agent {
                docker {
                    image 'python:3.9-slim'
                    args '-u root'
                    reuseNode true
                }
            }
            steps {
                sh 'pip install django==3.2'
                sh 'PYTHONDONTWRITEBYTECODE=1 python3 manage.py check'
                echo 'Django checks passed. Proceeding to next stage...'
            }
        }

        stage('Deploy') {
            steps {
                sh 'docker build -t todo .'
                sh 'docker run -d -p 8000:8000 --name todo_container todo'
            }
            post {
                always {
                    echo 'Waiting for 2 minutes before stopping and deleting containers...'
                    sleep 120
                    echo 'Stopping container...'
                    sh 'docker stop todo_container'
                    echo 'Removing container...'
                    sh 'docker rm todo_container'
                }
            }
        }
    }
    post {
        success {
            echo 'Pipeline executed successfully'
        }
        failure {
            echo 'Pipeline execution failed'
        }
        always {
            echo 'Pipeline execution completed'
        }
    }
}
